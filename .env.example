# MAX Bot API
MAX_TOKEN=your_max_bot_token
MAX_ALLOWED_USER_ID=123456789
MAX_API_URL=https://platform-api.max.ru

# OpenCode Server
OPENCODE_API_URL=http://localhost:4096
OPENCODE_PASSWORD=

# Knowledge base article ingestion
KB_INGEST_URL=http://127.0.0.1:8100/ingest
KB_LIST_URL=http://127.0.0.1:8100/articles
KB_INGEST_TOKEN=
KB_SUMMARIZE_WITH_OPENCODE=true

# VPN configs from Goida VPN lists 1, 6, 22, 23, 24 and 26
# Optional comma-separated source URL override:
# VPN_SOURCE_URLS=https://raw.githubusercontent.com/aneek0/goida-vpn-configs/refs/heads/main/githubmirror/1.txt
VPN_XRAY_KNIFE_PATH=xray-knife

# OpenCode Auto-restart
OPENCODE_AUTO_RESTART_ENABLED=true
OPENCODE_MONITOR_INTERVAL_SEC=30

# Bot settings
OPENCODE_MODEL=
OPENCODE_LOCALE=ru

# Logging
LOG_LEVEL=info
