{
  "name": "opencode-max-bot",
  "version": "0.1.0",
  "description": "MAX messenger bot client for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-max": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "max",
    "messenger",
    "bot",
    "opencode"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.21",
    "dotenv": "^17.2.3",
    "https-proxy-agent": "^7.0.6",
    "mdast-util-to-string": "^4.0.0",
    "node-fetch": "^2.7.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "socks-proxy-agent": "^8.0.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
